/**
 * ⚡ JALANKAN SALAH SATU FUNGSI INI DARI DROPDOWN APPS SCRIPT:
 * - tambahKolomCreditGaleri (Bahasa Indonesia)
 * - addAutoSelectCreditColumn (Bahasa Inggris)
 * Untuk membuat kolom autoselect_credits otomatis di spreadsheet sheet 'Galeri'
 */
function tambahKolomCreditGaleri() {
  return setupAutoSelectCreditColumn();
}

function addAutoSelectCreditColumn() {
  return setupAutoSelectCreditColumn();
}

function setupAutoSelectCreditColumn() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getSheetByName('Galeri') || ss.getSheetByName('Gallery') || ss.getSheetByName('galeri');
  if (!sheet) {
    Logger.log("Error: Sheet 'Galeri' atau 'Gallery' tidak ditemukan.");
    return "Error: Sheet 'Galeri' atau 'Gallery' tidak ditemukan.";
  }
  
  var lastCol = Math.max(1, sheet.getLastColumn());
  var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  var colIdx = -1;
  
  for (var i = 0; i < headers.length; i++) {
    var h = String(headers[i] || '').trim().toLowerCase();
    if (h === 'autoselect_credits' || h === 'autoselectcredits' || h === 'credits' || h === 'credit') {
      colIdx = i + 1;
      break;
    }
  }
  
  if (colIdx === -1) {
    colIdx = lastCol + 1;
    sheet.getRange(1, colIdx).setValue('autoselect_credits');
  }
  
  var lastRow = sheet.getLastRow();
  var filledCount = 0;
  if (lastRow > 1) {
    for (var r = 2; r <= lastRow; r++) {
      var val = sheet.getRange(r, colIdx).getValue();
      if (val === '' || val === null || val === undefined) {
        sheet.getRange(r, colIdx).setValue(1);
        filledCount++;
      }
    }
  }
  
  SpreadsheetApp.flush();
  var msg = "BERHASIL! Kolom 'autoselect_credits' aktif di kolom ke-" + colIdx + " dan diisi 1 credit untuk " + filledCount + " galeri.";
  Logger.log(msg);
  return msg;
}


