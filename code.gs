        results.push({
          id_galeri: data[i][map['id_galeri']],
          nama_client: data[i][map['nama_client']],
          judul_acara: data[i][map['judul_acara']],
          link_drive: data[i][map['link_drive']],
          batas_foto: data[i][map['batas_foto']],
          deadline: safeDateFormat(data[i][map['deadline']]),
          tanggal_acara: safeDateFormat(data[i][map['tanggal_acara']]),
          highlight: data[i][map['highlight']],
          email_client: data[i][map['email_client']],
          whatsapp_client: data[i][map['whatsapp_client']],
          whatsapp_vendor: (map['whatsapp_vendor'] !== undefined && data[i][map['whatsapp_vendor']]) ? String(data[i][map['whatsapp_vendor']]) : '',
          nama_vendor: (map['nama_vendor'] !== undefined && data[i][map['nama_vendor']]) ? String(data[i][map['nama_vendor']]) : '',
          kirim_tanpa_drive: (map['kirim_tanpa_drive'] !== undefined && data[i][map['kirim_tanpa_drive']] !== '') ? (data[i][map['kirim_tanpa_drive']] === true || data[i][map['kirim_tanpa_drive']] === 'true' || String(data[i][map['kirim_tanpa_drive']]).toLowerCase() === 'true' || data[i][map['kirim_tanpa_drive']] === 1) : true,
          izin_download: data[i][map['izin_download']] === true || data[i][map['izin_download']] === 'true' || String(data[i][map['izin_download']]).toLowerCase() === 'true' || String(data[i][map['izin_download']]).toLowerCase() === 'ya' || String(data[i][map['izin_download']]) === '1',
          autoselect_credits: galCredits,
          status: data[i][map['status']]
        });
      }
    }
    
    // Sort descending by implicit creation time (row index)
    results.reverse();
    return { success: true, data: results };
  } catch (e) {
    return { success: false, message: e.message };
  }
}

function updateGallery(token, payload) {
  var user = validateSession(token);
  if (!user) return { success: false, message: 'Session expired', sessionExpired: true };

  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(5000);
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Galeri');
    var map = ensureGalleryVendorColumn(sheet);
    var data = sheet.getDataRange().getValues();
    var rowIndex = -1;

    for (var i = 1; i < data.length; i++) {
      if (data[i][map['id_galeri']] === payload.id_galeri && data[i][map['id_fotografer']] === user.id_user) {
        rowIndex = i + 1;
        break;
      }
    }

    if (rowIndex === -1) return { success: false, message: 'Galeri tidak ditemukan.' };

    if (payload.link_drive !== undefined) {
      var oldLink = String(data[rowIndex - 1][map['link_drive']] || '');
      var cleanLink = sanitizeInput(payload.link_drive.trim());
      sheet.getRange(rowIndex, map['link_drive'] + 1).setValue(cleanLink);
      if (oldLink !== cleanLink && cleanLink) {
        // Hapus file foto lama di sheet Foto agar digantikan foto baru dari link Google Drive baru
        try {
          var photoSheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Foto');
          deleteGalleryRows(photoSheet, payload.id_galeri, 'Foto');
        } catch (delErr) {
          Logger.log('Error deleting old photos: ' + delErr);
        }
        importPhotosFromDriveFolder(SpreadsheetApp.getActiveSpreadsheet(), payload.id_galeri, cleanLink);
      }
    }
    if (payload.nama_client !== undefined) sheet.getRange(rowIndex, map['nama_client'] + 1).setValue(sanitizeInput(payload.nama_client));
    if (payload.email_client !== undefined) sheet.getRange(rowIndex, map['email_client'] + 1).setValue(sanitizeInput(payload.email_client));
    if (payload.whatsapp_client !== undefined) sheet.getRange(rowIndex, map['whatsapp_client'] + 1).setValue(sanitizeInput(payload.whatsapp_client));
    if (payload.nama_vendor !== undefined && map['nama_vendor'] !== undefined) {
      sheet.getRange(rowIndex, map['nama_vendor'] + 1).setValue(sanitizeInput(payload.nama_vendor));
    }
    if (payload.whatsapp_vendor !== undefined && map['whatsapp_vendor'] !== undefined) {
      sheet.getRange(rowIndex, map['whatsapp_vendor'] + 1).setValue(sanitizeInput(payload.whatsapp_vendor));
    }
    if (payload.tanggal_acara !== undefined) sheet.getRange(rowIndex, map['tanggal_acara'] + 1).setValue(payload.tanggal_acara);
    if (payload.deadline !== undefined) sheet.getRange(rowIndex, map['deadline'] + 1).setValue(payload.deadline);
    if (payload.highlight !== undefined) sheet.getRange(rowIndex, map['highlight'] + 1).setValue(sanitizeInput(payload.highlight));
    if (payload.batas_foto !== undefined) sheet.getRange(rowIndex, map['batas_foto'] + 1).setValue(parseInt(payload.batas_foto, 10) || 30);
    if (payload.izin_download !== undefined) sheet.getRange(rowIndex, map['izin_download'] + 1).setValue(payload.izin_download === true);
    if (payload.kirim_tanpa_drive !== undefined && map['kirim_tanpa_drive'] !== undefined) {
      sheet.getRange(rowIndex, map['kirim_tanpa_drive'] + 1).setValue(payload.kirim_tanpa_drive === true);
    }
    if (payload.autoselect_credits !== undefined && map['autoselect_credits'] !== undefined) {
      var numCredits = Math.max(0, parseInt(payload.autoselect_credits, 10) || 0);
      sheet.getRange(rowIndex, map['autoselect_credits'] + 1).setValue(numCredits);
    }

    SpreadsheetApp.flush();

    // Hapus script cache agar data di client langsung terperbarui otomatis
    var cleanGalId = String(payload.id_galeri).trim().toUpperCase();
    try { CacheService.getScriptCache().remove('pub_gal_' + cleanGalId); } catch(cErr) {}

    logAction('UPDATE_GALLERY', user.id_user, payload.id_galeri);
    return { success: true, autoselect_credits: payload.autoselect_credits };
  } catch (e) {
    return { success: false, message: e.message };
  } finally {
    lock.releaseLock();
  }
}

