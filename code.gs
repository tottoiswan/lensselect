  }
}

function deductGalleryAutoSelectCredit(galId) {
  if (!galId) return { success: false, message: 'Kode galeri tidak diberikan.', locked: true };
  var cleanGalId = String(galId).trim().toUpperCase();
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(5000);
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    var sheet = ss.getSheetByName('Galeri') || ss.getSheetByName('Gallery') || ss.getSheetByName('galeri');
    if (!sheet) return { success: false, message: 'Sheet Galeri tidak ditemukan.', locked: true };
    var map = ensureGalleryVendorColumn(sheet);
    var data = sheet.getDataRange().getValues();
    var rowIndex = -1;
    var currentCredits = 1;
    for (var i = 1; i < data.length; i++) {
      if (String(data[i][map['id_galeri']] || '').trim().toUpperCase() === cleanGalId) {
        rowIndex = i + 1;
        var raw = map['autoselect_credits'] !== undefined ? data[i][map['autoselect_credits']] : 1;
        currentCredits = (raw !== '' && raw !== undefined && !isNaN(Number(raw))) ? Number(raw) : 1;
        break;
      }
    }
    if (rowIndex === -1) return { success: false, message: 'Galeri tidak ditemukan.', locked: true };
    if (currentCredits <= 0) {
      return { success: false, message: 'Credit AutoSelect untuk galeri ini habis (0 Credit). Silakan tambah credit pada menu Ubah Galeri di Dashboard.', credits: 0, outOfCredits: true };
    }
    var newCredits = currentCredits - 1;
    sheet.getRange(rowIndex, map['autoselect_credits'] + 1).setValue(newCredits);
    SpreadsheetApp.flush();
    logAction('DEDUCT_GAL_CREDIT', cleanGalId, { remaining: newCredits });
    return { success: true, credits: newCredits, message: '1 Credit galeri digunakan. Sisa credit: ' + newCredits + 'x sesi.' };
  } catch (e) {
    return { success: false, message: e.message };
  } finally {
    try { lock.releaseLock(); } catch(e) {}
  }
}

