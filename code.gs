/**
 * Setup Database & Admin Awal
 */
function setupDatabase() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheets = {
    'User': ['id_user', 'nama', 'email', 'role', 'paket', 'username', 'password', 'wa_vendor', 'logo_vendor', 'custom_domain'],
    'Galeri': ['id_galeri', 'id_fotografer', 'nama_client', 'judul_acara', 'link_drive', 'batas_foto', 'deadline', 'tanggal_acara', 'highlight', 'email_client', 'whatsapp_client', 'izin_download', 'status', 'whatsapp_vendor', 'nama_vendor', 'kirim_tanpa_drive'],
    'Foto': ['id_foto', 'id_galeri', 'nama_file', 'url_foto', 'nomor_foto', 'nama_folder'],
    'Seleksi': ['id_seleksi', 'id_galeri', 'id_foto', 'pesan_client', 'tanggal_pilih'],
    'Job': ['id_job', 'id_fotografer', 'nama_client', 'tanggal_acara', 'status'],
    'TempFolder': ['id_folder', 'id_galeri', 'nama_folder', 'url_folder', 'tanggal_buat', 'tanggal_kadaluarsa', 'status'],
    'AuditLog': ['timestamp', 'action', 'user', 'details']
  };

  for (var name in sheets) {
    var sheet = ss.getSheetByName(name);
    if (!sheet) {
      sheet = ss.insertSheet(name);
      sheet.appendRow(sheets[name]);
      sheet.setFrozenRows(1);
    } else {
      var lastCol = Math.max(1, sheet.getLastColumn());
      var headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
      for (var colIdx = 0; colIdx < sheets[name].length; colIdx++) {
        var colName = sheets[name][colIdx];
        if (headers.indexOf(colName) === -1) {
          lastCol++;
          sheet.getRange(1, lastCol).setValue(colName);
          headers.push(colName);
        }
      }
    }
  }

  // Setup Default Admin
  var userSheet = ss.getSheetByName('User');
  var users = userSheet.getDataRange().getValues();
  var adminExists = false;
  for (var i = 1; i < users.length; i++) {
    if (users[i][5] === 'admin') {
      adminExists = true;
      break;
    }
  }

  if (!adminExists) {
    var adminPass = hashPassword('Admin@2026');
    userSheet.appendRow(['U' + new Date().getTime(), 'Fotografer Studio', 'studio@email.com', 'Fotografer', 'PRO', 'admin', adminPass]);
  }
}

/**
 * Keamanan & Helper
 */
function hashPassword(password) {
  var signature = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, password);
  var hash = '';
  for (var i = 0; i < signature.length; i++) {
    var byte = signature[i];
    if (byte < 0) byte += 256;
    var byteStr = byte.toString(16);
    if (byteStr.length == 1) byteStr = '0' + byteStr;
    hash += byteStr;
  }
  return hash;
}

function generateSessionToken() {
  return Utilities.getUuid();
}

function sanitizeInput(input) {
  if (typeof input !== 'string') return input;
  return input.replace(/</g, "&lt;").replace(/>/g, "&gt;").trim();
}

function getMapFromHeaders(headers) {
  var map = {};
  if (!headers || !headers.length) return map;
  for (var i = 0; i < headers.length; i++) {
    var raw = String(headers[i]).trim();
    if (!raw) continue;
    map[raw] = i;
    var lower = raw.toLowerCase();
    map[lower] = i;
    var norm = lower.replace(/[\s\-_]+/g, '');
    map[norm] = i;
  }
  if (map['autoselect_credits'] === undefined) {
    var aliases = ['autoselectcredits', 'autoselect_credit', 'autoselectcredit', 'credit_autoselect', 'creditautoselect', 'credit', 'credits'];
    for (var a = 0; a < aliases.length; a++) {
      if (map[aliases[a]] !== undefined) {
        map['autoselect_credits'] = map[aliases[a]];
        break;
      }
    }
  }
  return map;
}

function getColumnMap(sheet, optHeaders) {
  var headers = optHeaders;
  if (!headers || !headers.length) {
    var lastCol = Math.max(1, sheet.getLastColumn());
    headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0];
  }
  return getMapFromHeaders(headers);
}

function ensurePhotoFolderColumn(photoSheet, optMap) {
  var map = optMap || getColumnMap(photoSheet);
  if (map['nama_folder'] === undefined) {
    var lastCol = Math.max(1, photoSheet.getLastColumn());
    photoSheet.getRange(1, lastCol + 1).setValue('nama_folder');
    return getColumnMap(photoSheet);
  }
  return map;
}

function ensureGalleryVendorColumn(galSheet, optMap) {
  var lastCol = Math.max(1, galSheet.getLastColumn());
  var headers = galSheet.getRange(1, 1, 1, lastCol).getValues()[0];
  var map = getMapFromHeaders(headers);
  var nextCol = headers.length + 1;
  var changed = false;

  var requiredCols = ['whatsapp_vendor', 'nama_vendor', 'kirim_tanpa_drive', 'autoselect_credits'];
  for (var c = 0; c < requiredCols.length; c++) {
    var colName = requiredCols[c];
    if (map[colName] === undefined) {
      galSheet.getRange(1, nextCol).setValue(colName);
      headers.push(colName);
      map[colName] = nextCol - 1;
      nextCol++;
      changed = true;
    }
  }

  if (changed) {
    SpreadsheetApp.flush();
    return getColumnMap(galSheet);
  }
  return map;
}

function ensureUserColumns(userSheet, optMap) {
  var map = optMap || getColumnMap(userSheet);
  var changed = false;
  var required = ['wa_vendor', 'logo_vendor', 'custom_domain'];
  for (var i = 0; i < required.length; i++) {
    var col = required[i];
    if (map[col] === undefined) {
      var lastCol = Math.max(1, userSheet.getLastColumn());
      userSheet.getRange(1, lastCol + 1).setValue(col);
      changed = true;
      map = getColumnMap(userSheet);
    }
  }
  return map;
}


