    for (var i = 1; i < data.length; i++) {
      if (String(data[i][map['id_galeri']] || '').trim().toUpperCase() === cleanGalId) {
        var raw = map['autoselect_credits'] !== undefined ? data[i][map['autoselect_credits']] : 1;
